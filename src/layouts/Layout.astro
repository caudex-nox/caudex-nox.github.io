---
interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Caudex | Portfolio',
	description = 'Desarrollo full-stack moderno, arquitecturas escalables y soluciones digitales modulares. Construyendo tecnología robusta desde las bases, pensada para instituciones y empresas.'
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
	</head>
	<body>
		<div class="glow-background"></div>
		<slot />
	</body>
</html>

<style is:global>
	@import '../styles/global.css';
</style>
