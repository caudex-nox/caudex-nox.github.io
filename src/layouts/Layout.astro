---
interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Caudex | Portfolio',
	description = 'Desarrollo full-stack moderno, arquitecturas escalables y soluciones digitales modulares. Construyendo tecnología robusta desde las bases, pensada para instituciones y empresas.'
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		
		<!-- Favicons dinámicos según el tema -->
		<link rel="icon" id="favicon-dark" type="image/svg+xml" href="/favicon-dark.svg" media="(prefers-color-scheme: dark)" />
		<link rel="icon" id="favicon-light" type="image/svg+xml" href="/favicon-light.svg" media="(prefers-color-scheme: light)" />
		<link rel="alternate icon" href="/favicon.svg" />
		
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

		<!-- Detección temprana del tema del navegador para evitar parpadeos (FOUC) -->
		<script is:inline>
			(function () {
				const savedTheme = typeof localStorage !== 'undefined' ? localStorage.getItem('theme') : null;
				let theme;
				if (savedTheme) {
					theme = savedTheme;
				} else {
					const prefersLight = window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches;
					theme = prefersLight ? 'light' : 'dark';
				}
				document.documentElement.setAttribute('data-theme', theme);
			})();
		</script>
	</head>
	<body>
		<div class="glow-background"></div>
		<slot />
	</body>
</html>

<style is:global>
	@import '../styles/global.css';
</style>
